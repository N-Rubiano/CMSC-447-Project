# ============================================================
# PunchList Pro — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it is in .gitignore).
# ============================================================

# --- Database ---
# Leave blank to use SQLite fallback (great for local dev)
DATABASE_URL=

# SQLite fallback path
SQLITE_PATH=./punchlist.db

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server ---
HOST=0.0.0.0
PORT=4000

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
