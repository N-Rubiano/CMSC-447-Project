# ==============================================================================
# PunchList Pro - Python Backend Environment Variables Template
# Copy this file to .env and fill in your real credentials
# ==============================================================================

# Server Configuration
PORT=4000
PYTHON_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# If DATABASE_URL is set, PostgreSQL is used. Otherwise SQLite fallback is used.
# ------------------------------------------------------------------------------
# Option A: Full Connection String URL (Recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/PunchList

# Option B: Individual PostgreSQL Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=PunchList
PGUSER=postgres
PGPASSWORD=password
PGSSL=false

# SQLite fallback path (used when DATABASE_URL is not set)
SQLITE_PATH=./data/punchlist.db

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=punchlist-pro-secret-key-super-secure-2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & Client Origins
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# File Storage & Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=150
