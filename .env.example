PORT=4000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/punchlist_db

PGHOST=localhost
PGPORT=5432
PGDATABASE=punchlist_db
PGUSER=postgres
PGPASSWORD=password
PGSSL=false

JWT_SECRET=punchlist-pro-secret-key-change-in-production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
VITE_API_URL=http://localhost:4000
